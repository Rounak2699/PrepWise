# Copy this file to .env and adjust values for your environment.

# development | production
APP_ENV=development

# SQLite is used by default for local dev. In production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://placement:placement@db:5432/placement
DATABASE_URL=sqlite:///./placement.db

# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173

# IANA timezone used to determine each user's "day" for the daily challenge / streaks.
APP_TIMEZONE=Asia/Kolkata

# Optional. Leave blank to run without AI narrative reports — scoring and progress
# tracking work fully without it; report summaries fall back to a template.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=15
